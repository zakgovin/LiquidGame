msgid "BRAND_TITLE"
msgstr "ГИДРОЛОГИКА"

msgid "BRAND_SUBTITLE"
msgstr "H Y D R O L O G I C"

msgid "PLAY"
msgstr "Играть"

msgid "SETTINGS"
msgstr "Настройки"

msgid "ABOUT"
msgstr "Об игре"

msgid "LEVELS"
msgstr "Уровни"

msgid "MAIN_MENU"
msgstr "В главное меню"

msgid "PAUSE"
msgstr "Пауза"

msgid "CONTINUE"
msgstr "Продолжить"

msgid "RESTART"
msgstr "Начать заново"

msgid "REPLAY"
msgstr "Ещё раз"

msgid "RELEASE_WATER"
msgstr "Открыть резервуар"

msgid "OPENING"
msgstr "Открываем…"

msgid "READY_HINT"
msgstr "Держите телефон удобно.\nОткройте резервуар, когда будете готовы."

msgid "LEVEL_FIRST_LOOP"
msgstr "Первый виток"

msgid "CHOOSE_ROUTE"
msgstr "Выберите маршрут"

msgid "LEVEL_ROUTE"
msgstr "Полный виток по объёмному каналу.\nСтупени, инерция и переливание в сосуд."

msgid "LEVEL_COUNT"
msgstr "В прототипе доступны десять уровней."

msgid "LANGUAGE"
msgstr "Язык"

msgid "CONTROLS"
msgstr "Управление"

msgid "MODE_TILT"
msgstr "Наклон"

msgid "SENSITIVITY"
msgstr "Чувствительность"

msgid "SOFTER"
msgstr "Мягче  0,5"

msgid "FASTER"
msgstr "Быстрее  1,8"

msgid "CONTROL_HELP"
msgstr "Положение телефона запоминается при открытии резервуара.\nПри ×1: 6° — спокойная зона, 36° — полный наклон."

msgid "NO_SENSOR"
msgstr "Датчик не найден. Выберите режим «Вращение»."

msgid "FEEDBACK"
msgstr "Отклик"

msgid "TILT_FEEDBACK"
msgstr "Наклон поля"

msgid "TILT_DESCRIPTION"
msgstr "Заметно наклонять уровень вслед за телефоном"

msgid "SOUNDS"
msgstr "Звуки игры"

msgid "SOUND_DESCRIPTION"
msgstr "Нажатия, открытие резервуара и результат уровня"

msgid "ABOUT_NAME"
msgstr "Гидрологика / Hydrologic"

msgid "ABOUT_GAMEPLAY"
msgstr "Наклоняйте телефон или вращайте поле пальцем, чтобы провести воду по каналам в красный сосуд. Для победы нужно доставить не менее 80% воды."

msgid "ABOUT_HEIGHTS"
msgstr "Объёмные стеклянные стенки позволяют видеть воду. Полосатые перегибы и стрелки показывают направление спуска. Резкие движения могут расплескать воду."

msgid "ABOUT_PAUSE"
msgstr "Пауза останавливает поток. Из неё можно начать заново или вернуться в главное меню."

msgid "ABOUT_FUTURE"
msgstr "Вода — первая жидкость прототипа. По задумке должны быть и другие жидкости, но развитие прототипа на паузе."

msgid "AUTHORS"
msgstr "Авторы игры"

msgid "VERSION"
msgstr "Версия %s\nGodot / godot-cpp · MIT\nNoto Sans · SIL OFL"

msgid "WIN_TITLE"
msgstr "Уровень пройден"

msgid "WIN_VOLUME"
msgstr "В сосуде %.1f%% воды"

msgid "FAIL_TITLE"
msgstr "Вода расплескалась"

msgid "FAIL_HINT"
msgstr "Оставшегося объёма недостаточно"

msgid "MODE_ROTATE"
msgstr "Вращение"

msgid "ROTATION_HELP"
msgstr "Ведите пальцем вокруг центра уровня. Вода всегда течёт к нижнему краю экрана."

msgid "READY_ROTATE_HINT"
msgstr "Поверните поле пальцем.\nОткройте резервуар, когда будете готовы."

msgid "ROTATION_SENSITIVITY"
msgstr "Чувствительность меняет скорость вращения поля вслед за пальцем."

msgid "TILT_ONLY"
msgstr "Доступно в режиме «Наклон»"

msgid "TAP_RESERVOIR"
msgstr "Нажмите на резервуар ↓"

msgid "WIN_BALANCE"
msgstr "На уровне %.1f%% · Потеряно %.1f%%"

msgid "LEVEL_SWITCHBACKS"
msgstr "Повороты"

msgid "SWITCHBACKS_ROUTE"
msgstr "Извилистый маршрут с проёмом во внешнем борту.\nПроведите поток по целому дну, не вылив его за край."

msgid "NEXT_LEVEL"
msgstr "Следующий уровень"

msgid "LEVEL_BOTTLENECK"
msgstr "Узкое горлышко"

msgid "BOTTLENECK_ROUTE"
msgstr "Плавно проведите воду через узкий проход.\nСильный наклон перельёт её через низкие борта в ловушки."

msgid "LEVEL_FORK"
msgstr "Развилка"

msgid "FORK_ROUTE"
msgstr "Разделите поток и соберите обе части.\nДоставленная вода остаётся в защищённом приёмнике."

msgid "LEVEL_CASCADE"
msgstr "Каскад"

msgid "CASCADE_ROUTE"
msgstr "Пройдите глубокий каскад и крутой подъём сильным наклоном.\nМеняйте направление; финальный сосуд открыт."

msgid "LEVEL_IMPULSE"
msgstr "Импульс"

msgid "IMPULSE_ROUTE"
msgstr "Соберите воду и сильным ударом откройте тугую пружинную створку.\nФинальный приёмник открыт."

msgid "LEVEL_HOT_ZONE"
msgstr "Горячая зона"

msgid "HOT_ZONE_ROUTE"
msgstr "Пройдите нагретый поворот без задержки.\nВода нагревается, испаряется и уходит паром."

msgid "LEVEL_FREEZE"
msgstr "Заморозка"

msgid "FREEZE_ROUTE"
msgstr "Заморозьте воду в синей камере и проведите лёд по решётке.\nОткрытый приёмник засчитывает лёд."

msgid "LEVEL_THAW"
msgstr "Оттепель"

msgid "THAW_ROUTE"
msgstr "Доставьте лёд через решётку и быстро проведите талую воду через нагреватель.\nОн испаряет воду так же, как в «Горячей зоне»; приёмник открыт."

msgid "LEVEL_FULL_CYCLE"
msgstr "Полный цикл"

msgid "FULL_CYCLE_ROUTE"
msgstr "Соберите обе порции в накопителе.\nОткройте его, ударьте по заслонке, заморозьте воду,\nпройдите две решётки и растопите лёд. Цель — последний сосуд."

msgid "CAMERA_COLLECTOR"
msgstr "К накопителю"

msgid "CAMERA_WATER"
msgstr "К воде"
