msgid "CONTROL_HELP"
msgstr "Your phone position is set as neutral when you release the water.\nAt ×1: a 6° neutral zone, full tilt at 36°."

msgid "NO_SENSOR"
msgstr "No motion sensor found. Choose Rotate mode."

msgid "FEEDBACK"
msgstr "Feedback"

msgid "TILT_FEEDBACK"
msgstr "Board tilt"

msgid "TILT_DESCRIPTION"
msgstr "Visibly tilt the board with your phone"

msgid "SOUNDS"
msgstr "Game sounds"

msgid "SOUND_DESCRIPTION"
msgstr "Button taps, water release and level results"

msgid "ABOUT_NAME"
msgstr "Hydrologic"

msgid "ABOUT_GAMEPLAY"
msgstr "Tilt your phone or rotate the board with your finger to guide water through the channels into the red vessel. Deliver at least 80% of the water to win."

msgid "ABOUT_HEIGHTS"
msgstr "Solid glass walls keep the water visible. Striped step folds and arrows show the downhill direction. Sudden movements can spill water."

msgid "ABOUT_PAUSE"
msgstr "Pause stops the flow. You can restart the level or return to the main menu."

msgid "ABOUT_FUTURE"
msgstr "Water is the prototype's first liquid. More materials and interactions are planned."

msgid "AUTHORS"
msgstr "Game creators"

msgid "VERSION"
msgstr "Version %s\nGodot / godot-cpp · MIT\nNoto Sans · SIL OFL"

msgid "WIN_TITLE"
msgstr "Level complete"

msgid "WIN_VOLUME"
msgstr "%.1f%% of water delivered"

msgid "FAIL_TITLE"
msgstr "Water spilled"

msgid "FAIL_HINT"
msgstr "Not enough water remains"

msgid "MODE_ROTATE"
msgstr "Rotate"

msgid "ROTATION_HELP"
msgstr "Drag around the centre of the level. Water always flows towards the bottom of the screen."

msgid "READY_ROTATE_HINT"
msgstr "Rotate the board with your finger.\nRelease the water when you are ready."

msgid "ROTATION_SENSITIVITY"
msgstr "Sensitivity changes how quickly the board turns with your finger."

msgid "TILT_ONLY"
msgstr "Available in Tilt mode"

msgid "TAP_RESERVOIR"
msgstr "Tap the reservoir ↓"

msgid "WIN_BALANCE"
msgstr "On the board %.1f%% · Spilled %.1f%%"

msgid "LEVEL_SWITCHBACKS"
msgstr "Switchbacks"

msgid "SWITCHBACKS_ROUTE"
msgstr "A winding route with an opening in the outer wall.\nFollow the continuous floor without spilling over the edge."

msgid "NEXT_LEVEL"
msgstr "Next level"

msgid "LEVEL_BOTTLENECK"
msgstr "Bottleneck"

msgid "BOTTLENECK_ROUTE"
msgstr "Feed gently through the small opening.\nStrong tilt can overtop the low banks into the spill wells."

msgid "LEVEL_FORK"
msgstr "Fork"

msgid "FORK_ROUTE"
msgstr "Split the stream and collect both parts.\nDelivered water stays in the protected receiver."

msgid "LEVEL_CASCADE"
msgstr "Cascade"

msgid "CASCADE_ROUTE"
msgstr "Descend, climb the ramp, then descend again.\nChange direction; the final vessel is open."

msgid "LEVEL_IMPULSE"
msgstr "Impulse"

msgid "IMPULSE_ROUTE"
msgstr "Gather the water and strike the spring gate with a strong jet.\nA gentle stream cannot open it; the final vessel is open."

msgid "LEVEL_HOT_ZONE"
msgstr "Hot Zone"

msgid "HOT_ZONE_ROUTE"
msgstr "Cross the heated bend without lingering.\nWater heats up, evaporates and escapes as vapor."

msgid "LEVEL_FREEZE"
msgstr "Freeze"

msgid "FREEZE_ROUTE"
msgstr "Freeze the water in the blue chamber, then cross the grate.\nThe receiver counts solid ice."

msgid "LEVEL_THAW"
msgstr "Thaw"

msgid "THAW_ROUTE"
msgstr "Carry the ice across the grate to the heater.\nMelt it before the narrow passage into the receiver."
