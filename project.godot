; Hydrologic — Godot 4.6.3, Compatibility renderer (Android / desktop).
config_version=5

[application]
config/name="Гидрологика · Hydrologic"
config/description="Управляйте водой наклоном устройства или вращением поля. Десять уровней, высота, лёд и пар."
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.png"
config/version="0.16.0"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
sensors/enable_accelerometer=true
sensors/enable_gravity=true
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.92, 0.94, 0.94, 1)

[internationalization]
locale/translations=PackedStringArray("res://i18n/ru.po", "res://i18n/en.po")
locale/fallback="ru"
