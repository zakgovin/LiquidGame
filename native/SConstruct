import os
env = SConscript(os.path.join(os.environ['HYDRO_CPP_ROOT'], 'SConstruct'))
env.Append(CPPPATH=['src'])
if env['platform'] == 'ios':
    Default(env.StaticLibrary('obj/libhydrologic' + env['suffix'] + '.a', Glob('src/*.cpp')))
else:
    Default(env.SharedLibrary('obj/libhydrologic' + env['suffix'] + env['SHLIBSUFFIX'], Glob('src/*.cpp')))
