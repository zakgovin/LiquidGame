[configuration]
entry_symbol = "hydrologic_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/bin/libhydrologic.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://native/bin/libhydrologic.linux.template_release.x86_64.so"
android.debug.arm64 = "res://native/bin/libhydrologic.android.template_release.arm64.so"
android.release.arm64 = "res://native/bin/libhydrologic.android.template_release.arm64.so"
android.debug.x86_64 = "res://native/bin/libhydrologic.android.template_release.x86_64.so"
android.release.x86_64 = "res://native/bin/libhydrologic.android.template_release.x86_64.so"
macos.debug.arm64 = "res://native/bin/libhydrologic.macos.template_release.arm64.dylib"
macos.release.arm64 = "res://native/bin/libhydrologic.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://native/bin/libhydrologic.macos.template_release.x86_64.dylib"
macos.release.x86_64 = "res://native/bin/libhydrologic.macos.template_release.x86_64.dylib"
ios.debug = "res://native/bin/hydrologic.xcframework"
ios.release = "res://native/bin/hydrologic.xcframework"
